{
  "name": "cream-soda-rp",
  "version": "1.5.1",
  "description": "Cream Soda — a SillyTavern-style frontend for AI roleplay chats: the engine, the server and the interface in one package.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "server/index.js",
  "bin": {
    "cream-soda": "server/cli.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "postinstall": "npm --prefix web install --no-audit --no-fund",
    "dev": "node scripts/dev.js",
    "dev:server": "node server/cli.js --port 8000",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node server/cli.js",
    "check": "npm --prefix web run typecheck && node --test server/test/*.test.js",
    "test": "node --test server/test/*.test.js",
    "mock-llm": "node scripts/mock-llm.js",
    "launcher": "npm --prefix launcher/desktop start"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "qrcode": "^1.5.4",
    "socks": "^2.8.10",
    "undici": "^6.21.0"
  }
}
